<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad="RibbonOnLoad">
  <ribbon>
    <tabs>
      <tab id="tabCreateLetter" label="Формирование писем">
        <group id="grpCreateLetterLetters" label="1. Письма">
          <button id="btnRibbonOpenForm"
                  label="Сделать письмо"
                  size="large"
                  imageMso="FileOpen"
                  onAction="RibbonOpenLetterForm"
                  screentip="Сделать письмо"
                  supertip="Открывает форму формирования нового письма." />
          <button id="btnRibbonOpenHistory"
                  label="Поиск писем"
                  size="large"
                  imageMso="FindDialog"
                  onAction="RibbonOpenHistoryForm"
                  screentip="Поиск писем"
                  supertip="Открывает форму поиска и просмотра истории писем." />
        </group>
        <group id="grpCreateLetterPackages" label="2. Пакеты">
          <button id="btnRibbonOpenMailDispatch"
                  label="Добавить в пакет"
                  size="large"
                  imageMso="FileSendAsAttachment"
                  onAction="RibbonOpenMailDispatch"
                  screentip="Добавить письма в почтовый пакет"
                  supertip="Открывает форму подготовки почтового пакета: выбор писем, адресата, реестра и конверта." />
          <button id="btnRibbonOpenDispatchJournal"
                  label="Журнал/возврат"
                  size="large"
                  imageMso="TableOfContentsGallery"
                  onAction="RibbonOpenDispatchJournal"
                  screentip="Журнал и возврат пакетов"
                  supertip="Открывает журнал почтовых пакетов. Если пакет ещё не закрыт в реестре ОПС, его можно вернуть отдельной командой «Вернуть пакет»." />
          <button id="btnRibbonReturnDispatchPackage"
                  label="Вернуть пакет"
                  size="large"
                  imageMso="Undo"
                  onAction="RibbonReturnDispatchPackage"
                  screentip="Вернуть пакет"
                  supertip="Возвращает ошибочно упакованный пакет в работу, если он ещё не был напечатан в PDF-реестре." />
          <button id="btnRibbonCleanupDispatchLegacy"
                  label="Проверить данные"
                  size="large"
                  imageMso="Info"
                  onAction="RibbonCleanupDispatchLegacy"
                  screentip="Проверить данные пакетов"
                  supertip="Находит старые строки почтовых отправлений без статуса и реестра, затем по подтверждению возвращает связанные письма в работу." />
        </group>
        <group id="grpCreateLetterRegistry" label="3. Реестр">
          <button id="btnRibbonBuildDispatchRegistry"
                  label="Собрать реестр"
                  size="large"
                  imageMso="TableInsertExcelSpreadsheet"
                  onAction="RibbonBuildDispatchRegistry"
                  screentip="Собрать реестр из пакетов"
                  supertip="Собирает внутренний Excel-реестр из подготовленных почтовых пакетов." />
          <button id="btnRibbonExportPostalRegistryPdf"
                  label="Реестр ОПС"
                  size="large"
                  imageMso="FileSaveAsPdfOrXps"
                  onAction="RibbonExportPostalRegistryPdf"
                  screentip="Сформировать реестр ОПС"
                  supertip="Проверяет неупакованные письма, экспортирует печатный реестр для отделения почтовой связи и закрывает пакеты как напечатанные." />
        </group>
        <group id="grpCreateLetterEnvelopes" label="4. Конверты">
          <button id="btnRibbonPrepareEnvelopePrint"
                  label="Подготовить конверты"
                  size="large"
                  imageMso="PrintPreviewAndPrint"
                  onAction="RibbonPrepareEnvelopePrint"
                  screentip="Подготовить конверты"
                  supertip="Заполняет скрытые layout-листы C4, C5 и DL данными текущих почтовых пакетов для печати конвертов." />
        </group>
        <group id="grpCreateLetterSettings" label="5. Сервис">
          <button id="btnRibbonTemplateFolder"
                  label="Папка шаблонов"
                  size="large"
                  imageMso="FileOpen"
                  onAction="RibbonSelectTemplateFolder"
                  screentip="Папка шаблонов"
                  supertip="Позволяет выбрать папку, в которой лежат шаблоны Word." />
          <button id="btnRibbonOutputFolder"
                  label="Папка писем"
                  size="large"
                  imageMso="FileSaveAs"
                  onAction="RibbonSelectOutputFolder"
                  screentip="Папка писем"
                  supertip="Позволяет выбрать папку, в которую будут сохраняться сформированные письма." />
          <button id="btnRibbonAbout"
                  label="О программе"
                  size="large"
                  imageMso="FileProperties"
                  onAction="RibbonShowAbout"
                  screentip="О программе"
                  supertip="Показывает сведения о CreateLetter и текущих папках шаблонов и выгрузки." />
          <button id="btnRibbonProgramSettings"
                  label="Настройки"
                  size="large"
                  imageMso="PropertySheet"
                  onAction="RibbonShowProgramSettings"
                  screentip="Настройки программы"
                  supertip="Показывает, где настраиваются общие параметры программы. Настройки реестра ОПС больше не привязаны к этой кнопке." />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
